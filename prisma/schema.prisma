// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  decisions Decision[]

  @@index([email])
}

model Decision {
  id           String             @id @default(cuid())
  userId       String?
  anonymousId  String?
  title        String
  context      String
  influences   String
  category     String
  riskLevel    String             @default("General")
  isHighStakes Boolean            @default(false)
  currentStage String             @default("explored")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots    DecisionSnapshot[]
  reflections  Reflection[]

  @@index([userId])
  @@index([anonymousId])
  @@index([createdAt])
}

model DecisionSnapshot {
  id         String   @id @default(cuid())
  decisionId String
  version    Int      @default(1)
  reasoning  String
  analysis   Json
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model Reflection {
  id               String   @id @default(cuid())
  decisionId       String
  promptQuestion   String   @default("Has this changed how you think about the decision?")
  userNote         String
  updatedReasoning String
  exploredSpots    Json?
  createdAt        DateTime @default(now())
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}
